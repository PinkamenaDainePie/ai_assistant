# 本地 / 服务器：复制为项目根目录 `.env`（勿提交含真实 Key 的 .env）
#   copy .env.example .env
# pip install python-dotenv

# ========== 通义千问（王安石与其它角色默认共用）==========
DASHSCOPE_API_KEY=sk-请替换为你的Key
DASHSCOPE_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
DEFAULT_LLM_MODEL=qwen-plus
LLM_REQUEST_TIMEOUT=300

# ========== 诏书 L3 意图解析（/edict/parse、/quarter/settle）==========
# EDICT_L3_PROFILE=auto   默认：王安石走本地 Ollama 时，诏书 L3 自动用通义（需 DASHSCOPE_API_KEY）
# EDICT_L3_PROFILE=dashscope | wanganshi  强制指定端点

# ========== 王安石单独覆盖（可选；不设则问策与其余大臣一样走 DASHSCOPE）==========
# 本机 Ollama 较慢，仅调试时开启：
# WANGANSHI_USE_LOCAL_LLM=1
# WANGANSHI_API_BASE=http://127.0.0.1:11434/v1
# WANGANSHI_API_KEY=local-dev-key
# WANGANSHI_LLM_MODEL=qwen2.5:14b

# ========== 诏书解析：NLU 意图仅 L3 + 规则槽位；数值由执行帧 resolver 产出 ==========
# PARSER_NLU_SEPARATED=1  默认开启；设为 0 可回退旧 L1/L2/L3 effects 融合路径

# ========== 多域诏书（统一语义 LLM：L3 intent + 多域 segments，一次调用）==========
# EDICT_MULTI_DOMAIN_LLM=1       默认开启；0 关闭后回退单域 frame_builder
# EDICT_UNIFIED_SEMANTIC_LLM=1   默认随多域开启；parse 不再单独调 L3，由统一 LLM 写入 trace
# LLM_SEGMENT_OVERRIDE_JSON=      调试：跳过 LLM，直接注入 segments JSON

# ========== 季度朝政纪要（quarter/start）==========
# QUARTER_NARRATIVE_MODE=llm       默认 llm；template=仅模板无 API
# QUARTER_NARRATIVE_LLM_MODEL=qwen-turbo

# ========== 动作次生影响 agent-flow（agent_flow/，不接大臣对话）==========
# AGENT_FLOW_USE_LANGGRAPH=1
# DATABASE_URL=postgresql+psycopg2://user:pass@127.0.0.1:5432/ai_assistant
# AGENT_FLOW_AUTO_CREATE_TABLES=1    建 action_flow_states / agent_flow_runs 表
# AGENT_FLOW_BOT_APP_KEY=            Workflow A（ADP 旧版 SSE）；业务 JSON 整包写入 HTTP content
# AGENT_FLOW_SSE_URL=https://wss.lke.cloud.tencent.com/v1/qbot/chat/sse
# AGENT_FLOW_SSE_TIMEOUT=300

# Workflow B — 季度总结（ADP 旧版 SSE）；配置后 quarter/start 调用云端工作流
# QUARTER_NARRATIVE_BOT_APP_KEY=

# Workflow C — 结局总结（ADP 旧版 SSE）；战役收束时调用
# ENDING_SUMMARY_BOT_APP_KEY=

# ========== 熙宁战役结局测试（本地）==========
# CAMPAIGN_DEBUG=1                      quarter/start 的 campaign_end 附带 debug（权威/军心/streak）
# CAMPAIGN_DEBUG_GAME_OVER=authority    下一季 start 直接进坏结局「朝局失控」（测 UI）
# CAMPAIGN_DEBUG_GAME_OVER=viet_collapse  直接进坏结局「交趾丧师」（测 UI；勿在生产开启）

# ========== AI 助教 GraphRAG + Neo4j ==========
# TUTOR_USE_NEO4J=1
# NEO4J_URI=bolt://127.0.0.1:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=请替换
# NEO4J_DATABASE=neo4j
# TUTOR_LLM_MODEL=qwen-plus
# TUTOR_GRAPH_TOP_K=8
# 初始化图谱：python -m tutor_module.seed

# ========== 可选 ==========
# 王安石 RAG 是否合并全库 docs（默认不合并，避免明代史料干扰人设）
# RAG_WANGANSHI_MERGE_PROJECT_DOCS=0

# ========== 课堂账号 / 游玩记录（PostgreSQL）==========
# 腾讯云 PG 不可用时，可本地起库：
#   docker compose -f docker-compose.classroom.yml up -d
# 或安装 Windows 版 PostgreSQL 后自建库 classroom。
# DATABASE_URL=postgresql+psycopg2://classroom:classroom@127.0.0.1:5432/classroom
# CLASSROOM_JWT_SECRET=请替换为随机长字符串
# CLASSROOM_SEED_DEMO=1
# CLASSROOM_AUTO_CREATE_TABLES=1
# CLASSROOM_ALLOW_REGISTER=1
# 演示账号（SEED_DEMO=1）：teacher@demo.edu / student1@demo.edu / demo1234
