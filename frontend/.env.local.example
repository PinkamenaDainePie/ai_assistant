# 复制为 frontend/.env.local（Next 开发时自动读取）
#   cd frontend
#   copy .env.local.example .env.local

# 默认可走同源 `/api/backend/*`（Next rewrite）。本地 Ollama 很慢时，代理可能超时 → /chat 500。
# 开发推荐直连 FastAPI（与下方 BACKEND_PROXY_URL 同端口即可）：
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8000

# Next 开发服务器把 /api/backend 代理到哪（与默认 FastAPI 端口一致即可）
BACKEND_PROXY_URL=http://127.0.0.1:8000

# 明代 ming-salvage-sim（:8010）。Next 经 /api/ming-salvage 反代。
MING_SALVAGE_PROXY_URL=http://127.0.0.1:8010
# NEXT_PUBLIC_MING_SALVAGE_URL=http://127.0.0.1:8010

# 可选：覆盖场景表格根目录（Windows 绝对路径示例）
# NEXT_PUBLIC_SONG_DATA_ROOT=E:/ai_assistant/biaoge/song
# NEXT_PUBLIC_MING_DATA_ROOT=E:/ai_assistant/biaoge
